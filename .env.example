# Copiază în .env pe server: cp .env.example .env
# Folosit doar de docker-compose.prod.yml

POSTGRES_USER=kabbalah
POSTGRES_PASSWORD=schimba-parola-asta
POSTGRES_DB=kabbalah

# Adresa publică pe care ascultă Caddy.
# Cu domeniu: certificatul HTTPS se ia automat de la Let's Encrypt.
#   SITE_ADDRESS=chestionar.exemplu.ro
# Fără domeniu (test direct pe IP-ul instanței, doar HTTP):
#   SITE_ADDRESS=:80
SITE_ADDRESS=:80

# URL-ul public complet, folosit pentru CORS_ORIGIN în API.
PUBLIC_URL=http://localhost
